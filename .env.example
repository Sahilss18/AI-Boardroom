NODE_ENV=development

PORT=3000

# Gemini Developer API Key (Google AI Studio)
GEMINI_API_KEY=

# Groq / xAI Critic API Key
XAI_API_KEY=

# Primary & Secondary AI Provider (Configured to Groq/Grok)
PRIMARY_MODEL_PROVIDER=xai
PRIMARY_MODEL_NAME=openai/gpt-oss-20b
GROK_MODEL_NAME=openai/gpt-oss-20b
MOCK_AI=false

# Secondary Provider
SECONDARY_MODEL_PROVIDER=xai
SECONDARY_MODEL_NAME=openai/gpt-oss-20b

# Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=reflection_ai
MYSQL_USER=reflection_user
MYSQL_PASSWORD=reflection_password
MYSQL_ROOT_PASSWORD=rootpassword

# Redis Cache & Pub/Sub
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Local LLM Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Multimodal & Voice Pipeline
STT_PROVIDER=whisper
TTS_PROVIDER=kokoro
VAD_PROVIDER=silero
SPEECH_TO_SPEECH=false
